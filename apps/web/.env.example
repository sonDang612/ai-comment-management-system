# Template for every web env file:
#   apps/web/.env.local    host development (`pnpm env:init`)
#   apps/web/.env.<env>    Docker image, development | staging | production (`pnpm env:init <env>`)
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time: rebuild (`up --build`)
# after changing them. Never put secrets in NEXT_PUBLIC_*.

# Public base URL of the API as seen from the user's browser (not a Compose hostname).
NEXT_PUBLIC_API_URL=http://localhost:4000
