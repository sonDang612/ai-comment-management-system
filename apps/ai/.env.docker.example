# AI settings inside Docker, for one environment. Shared by the ai-server and ai-worker containers.
# Copy to apps/ai/.env.<env> (development | staging | production): `npm run env:init -- <env>`.
# APP_ENV and TZ are set by Compose. Hostnames are Compose service names.

APP_VERSION=0.1.0
LOG_LEVEL=INFO
# text | json (json for log shipping in staging/production)
LOG_FORMAT=text

# --- Server (acms_ai.server) ---
# Shared secret; must match AI_SERVICE_TOKEN in apps/api/.env.<env>. Use a long random value outside development.
INTERNAL_API_TOKEN=local-dev-internal-token

# --- Worker (acms_ai.worker) ---
# Same Redis (and db) as the API.
REDIS_URL=redis://redis:6379/0
# Must match AI_JOBS_QUEUE in packages/shared (QueueName.AI_JOBS).
QUEUE_NAME=ai-jobs
WORKER_CONCURRENCY=2
