// Central business schema, owned by the NestJS API.
//
// Rules:
//   * Every schema change goes through a migration: `pnpm db:migrate:create --name <change>`.
//   * Never edit a migration that has been applied anywhere; add a new one.
//   * Never use `prisma db push` against shared/staging/production databases.
//   * Every DateTime column is `@db.Timestamptz(3)` (an instant, stored as UTC). The project
//     time zone (UTC+8, @acms/shared `APP_TIME_ZONE`) is only for calendar logic and display.
//
// Tables live in the Postgres schema named by `?schema=` in DATABASE_URL (default: `app`).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Models are added together with the business features that need them.

model RuleSettings {
  id                 Int      @id @default(1) @db.SmallInt
  minLength          Int      @map("min_length")
  maxLength          Int      @map("max_length")
  maxRepeatedChars   Int      @map("max_repeated_chars")
  maxRepeatedWords   Int      @default(5) @map("max_repeated_words")
  restrictedKeywords String[] @map("restricted_keywords")
  allowIpAddresses   Boolean  @default(false) @map("allow_ip_addresses")
  domainWhitelist    String[] @map("domain_whitelist")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("rule_settings")
}

model Comment {
  id          String    @id @default(uuid()) @db.Uuid
  content     String
  isValid     Boolean?  @map("is_valid")
  isQuestion  Boolean?  @map("is_question")
  confidence  Decimal?  @db.Decimal(3, 2)
  reason      String?
  moderatedAt DateTime? @map("moderated_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@index([isValid])
  @@map("comments")
}