# Host development (`npm run dev`): copy to apps/ai/.env. Read by both entrypoints (server and worker).
# Docker uses apps/ai/.env.<env> (see .env.docker.example).

APP_ENV=local
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text

# --- Server (acms_ai.server) ---
# Shared secret; must match AI_SERVICE_TOKEN in apps/api/.env.
INTERNAL_API_TOKEN=local-dev-internal-token

# --- Worker (acms_ai.worker) ---
# Must point at the same Redis (and db) as BullMQ in the NestJS API (apps/api/.env: REDIS_URL).
REDIS_URL=redis://localhost:6379/0
# Must match AI_JOBS_QUEUE in packages/shared (QueueName.AI_JOBS).
QUEUE_NAME=ai-jobs
WORKER_CONCURRENCY=2
