# Docker infrastructure settings for one environment.
# Copy to infrastructure/docker/.env.<env> (development | staging | production): `npm run env:init -- <env>`.
# Read by Compose for interpolation only (scripts/docker.mjs passes it with --env-file).

# --- PostgreSQL ---
# Must match the credentials in DATABASE_URL of apps/api/.env.<env>.
POSTGRES_USER=acms
POSTGRES_PASSWORD=acms
POSTGRES_DB=acms

# --- Published ports (host side) ---
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=4000
WEB_PORT=3000
