# Web settings for the Docker image, for one environment.
# Copy to apps/web/.env.<env> (development | staging | production): `npm run env:init -- <env>`.
# NEXT_PUBLIC_* values are build arguments: they are inlined into the browser bundle, so
# rebuild the image (`up --build`) after changing them. Never put secrets in NEXT_PUBLIC_*.

# Public base URL of the API as seen from the user's browser (not a Compose hostname).
NEXT_PUBLIC_API_URL=http://localhost:4000
