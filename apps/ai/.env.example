# Template for every AI env file, read by both entrypoints (server and worker):
#   apps/ai/.env          host development (`npm run env:init`)
#   apps/ai/.env.<env>    Docker, development | staging | production (`npm run env:init -- <env>`)
# Values are written for the host (localhost). In Docker, Compose sets APP_ENV and TZ,
# and points REDIS_URL at the Compose `redis` service.

APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# text | json (json for log shipping in staging/production)
LOG_FORMAT=text

# --- Server (acms_ai.server) ---
# Shared secret; must match AI_SERVICE_TOKEN in apps/api. Use a long random value outside development.
INTERNAL_API_TOKEN=local-dev-internal-token

# --- Worker (acms_ai.worker) ---
# Must point at the same Redis (and db) as BullMQ in the NestJS API (REDIS_URL in apps/api).
REDIS_URL=redis://localhost:6379/0
# Must match AI_JOBS_QUEUE in packages/shared (QueueName.AI_JOBS).
QUEUE_NAME=ai-jobs
WORKER_CONCURRENCY=2
