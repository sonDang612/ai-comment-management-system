# Template for every AI env file, read by the worker (and the training CLI):
#   apps/ai/.env          host development (`pnpm env:init`)
#   apps/ai/.env.<env>    Docker, development | staging | production (`pnpm env:init <env>`)
# Values are written for the host (localhost). In Docker, Compose sets APP_ENV and TZ,
# and points REDIS_URL at the Compose `redis` service.

APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# text | json (json for log shipping in staging/production)
LOG_FORMAT=text

# --- Worker (acms_ai.worker) ---
# Must point at the same Redis (and db) as BullMQ in the NestJS API (REDIS_URL in apps/api).
REDIS_URL=redis://localhost:6379/0
# Must match AI_JOBS_QUEUE in packages/shared (QueueName.AI_JOBS).
QUEUE_NAME=ai-jobs
WORKER_CONCURRENCY=2
