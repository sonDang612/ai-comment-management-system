# Host development (`npm run dev`): copy to apps/api/.env. Docker uses apps/api/.env.<env> (see .env.docker.example).

# --- Application ---
NODE_ENV=development
# local | test | development | staging | production
APP_ENV=local
APP_VERSION=0.1.0
PORT=4000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Logging ---
# verbose | debug | log | warn | error | fatal
LOG_LEVEL=log
# text | json
LOG_FORMAT=text

# --- PostgreSQL (Prisma) ---
# Credentials must match infrastructure/docker/.env.development (`npm run infra:up`).
# `?schema=app`: all tables owned by this API live in the `app` Postgres schema.
DATABASE_URL=postgresql://acms:acms@localhost:5432/acms?schema=app

# --- Redis (BullMQ queues + cache) ---
REDIS_URL=redis://localhost:6379/0

# --- AI server (apps/ai, internal HTTP) ---
AI_SERVICE_URL=http://localhost:8000
# Shared secret; must match INTERNAL_API_TOKEN in apps/ai/.env.
AI_SERVICE_TOKEN=local-dev-internal-token
AI_SERVICE_TIMEOUT_MS=10000
