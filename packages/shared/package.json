{
  "name": "@acms/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Contracts shared by web, api (NestJS) and documented for the Python services.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
