# Template for every API env file:
#   apps/api/.env          host development (`pnpm env:init`)
#   apps/api/.env.<env>    Docker, development | staging | production (`pnpm env:init <env>`)
# Values are written for the host (localhost). In Docker, Compose sets APP_ENV, NODE_ENV, PORT and TZ,
# and points DATABASE_URL, REDIS_URL and VLLM_URL at the Compose services.
# Replace every secret before using staging/production.

# --- Application ---
NODE_ENV=development
# local | test | development | staging | production
APP_ENV=local
APP_VERSION=0.1.0
PORT=4000
# Comma-separated browser origins allowed to call the API (the web URL users open).
CORS_ORIGINS=http://localhost:3000

# --- Logging ---
# verbose | debug | log | warn | error | fatal
LOG_LEVEL=log
# text | json (json for log shipping in staging/production)
LOG_FORMAT=text

# --- PostgreSQL ---
# Read by Compose (--env-file) to create the `postgres` container's user and database, and to build
# DATABASE_URL inside Docker. Use URL-safe characters in the password.
POSTGRES_USER=acms
POSTGRES_PASSWORD=acms
POSTGRES_DB=acms
# Prisma on the host. Credentials must match POSTGRES_* above. `?schema=app`: tables live in the `app` schema.
DATABASE_URL=postgresql://acms:acms@localhost:5432/acms?schema=app

# --- Redis (BullMQ queues + cache) ---
REDIS_URL=redis://localhost:6379/0

# --- AI analysis (NestJS -> vLLM, OpenAI-compatible HTTP API) ---
# vllm | stub. `stub` marks every comment that passes the rules as valid without calling a model;
# it is refused unless APP_ENV is local, test or development.
AI_ANALYZER=vllm
# Below this confidence a non-question AI result is not stored: the comment stays unchecked (fail-safe).
AI_CONFIDENCE_THRESHOLD=0.85
# vLLM server root (without /v1). In Docker, Compose sets it to VLLM_COMPOSE_URL (default http://vllm:8000).
VLLM_URL=http://localhost:8000
# Served model name: the LoRA adapter name given to vLLM (--lora-modules <name>=<adapter dir>).
VLLM_MODEL=acms-moderation
# Optional bearer token; must match the API key vLLM was started with. Empty = no auth.
VLLM_API_KEY=
# Inference timeout. On timeout or any error the comment stays unchecked; it is never approved.
VLLM_TIMEOUT_MS=30000

# --- vLLM container (Compose only, `--profile vllm`) ---
# VLLM_COMPOSE_URL=http://vllm:8000
# VLLM_IMAGE_TAG=v0.11.0
# VLLM_BASE_MODEL=Qwen/Qwen3-1.7B
# Adapter folder of a training run, relative to infrastructure/docker/ (or absolute).
# VLLM_ADAPTER_DIR=../../apps/ai/training/outputs/qwen3-1.7b-lora-v1/adapter
# Must be >= the LoRA rank used in training.
# VLLM_MAX_LORA_RANK=16
# VLLM_MAX_MODEL_LEN=4096
# VLLM_GPU_MEMORY_UTILIZATION=0.85
# 1 = never download from Hugging Face (the base model must already be in the vllm-cache volume).
# VLLM_HF_HUB_OFFLINE=0
