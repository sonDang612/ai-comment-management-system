{
  "name": "ai-comment-management-system",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @acms/api db:migrate",
    "env:init": "node scripts/env-init.mjs",
    "docker": "node scripts/docker.mjs",
    "docker:up": "node scripts/docker.mjs development up -d --build",
    "docker:down": "node scripts/docker.mjs development down"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "turbo": "^2.11.11"
  }
}
