# Template for every API env file:
#   apps/api/.env          host development (`npm run env:init`)
#   apps/api/.env.<env>    Docker, development | staging | production (`npm run env:init -- <env>`)
# Values are written for the host (localhost). In Docker, Compose sets APP_ENV, NODE_ENV, PORT and TZ,
# and points DATABASE_URL, REDIS_URL and AI_SERVICE_URL at the Compose services.
# Replace every secret before using staging/production.

# --- Application ---
NODE_ENV=development
# local | test | development | staging | production
APP_ENV=local
APP_VERSION=0.1.0
PORT=4000
# Comma-separated browser origins allowed to call the API (the web URL users open).
CORS_ORIGINS=http://localhost:3000

# --- Logging ---
# verbose | debug | log | warn | error | fatal
LOG_LEVEL=log
# text | json (json for log shipping in staging/production)
LOG_FORMAT=text

# --- PostgreSQL ---
# Read by Compose (--env-file) to create the `postgres` container's user and database, and to build
# DATABASE_URL inside Docker. Use URL-safe characters in the password.
POSTGRES_USER=acms
POSTGRES_PASSWORD=acms
POSTGRES_DB=acms
# Prisma on the host. Credentials must match POSTGRES_* above. `?schema=app`: tables live in the `app` schema.
DATABASE_URL=postgresql://acms:acms@localhost:5432/acms?schema=app

# --- Redis (BullMQ queues + cache) ---
REDIS_URL=redis://localhost:6379/0

# --- AI server (apps/ai, internal HTTP) ---
AI_SERVICE_URL=http://localhost:8000
# Shared secret; must match INTERNAL_API_TOKEN in apps/ai. Use a long random value outside development.
AI_SERVICE_TOKEN=local-dev-internal-token
AI_SERVICE_TIMEOUT_MS=10000

# Default moderation thresholds (0..1), until they are configured per client and site
MODERATION_AUTO_APPROVE_THRESHOLD=0.85
MODERATION_AUTO_DISABLE_THRESHOLD=0.90
