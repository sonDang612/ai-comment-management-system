# Template for every API env file:
#   apps/api/.env          host development (`pnpm env:init`)
#   apps/api/.env.<env>    Docker, development | staging | production (`pnpm env:init <env>`)
# Values are written for the host (localhost). In Docker, Compose sets APP_ENV, NODE_ENV, PORT and TZ,
# and points DATABASE_URL, REDIS_URL and TEI_URL at the Compose services.
# Replace every secret before using staging/production.

# --- Application ---
NODE_ENV=development
# local | test | development | staging | production
APP_ENV=local
APP_VERSION=0.1.0
PORT=4000
# Comma-separated browser origins allowed to call the API (the web URL users open).
CORS_ORIGINS=http://localhost:3000

# --- Logging ---
# verbose | debug | log | warn | error | fatal
LOG_LEVEL=log
# text | json (json for log shipping in staging/production)
LOG_FORMAT=text

# --- PostgreSQL ---
# Read by Compose (--env-file) to create the `postgres` container's user and database, and to build
# DATABASE_URL inside Docker. Use URL-safe characters in the password.
POSTGRES_USER=acms
POSTGRES_PASSWORD=acms
POSTGRES_DB=acms
# Prisma on the host. Credentials must match POSTGRES_* above. `?schema=app`: tables live in the `app` schema.
DATABASE_URL=postgresql://acms:acms@localhost:5432/acms?schema=app

# --- Redis (BullMQ queues + cache) ---
REDIS_URL=redis://localhost:6379/0

# --- AI analysis (NestJS -> TEI, Hugging Face Text Embeddings Inference serving the trained classifier) ---
# classifier | stub. `stub` marks every comment that passes the rules as valid without calling a model;
# it is refused unless APP_ENV is local, test or development.
AI_ANALYZER=classifier
# Below this confidence a non-question AI result is not stored: the comment stays unchecked (fail-safe).
AI_CONFIDENCE_THRESHOLD=0.85
# TEI server root. In Docker, Compose sets it to CLASSIFIER_COMPOSE_URL (default http://classifier:8080).
TEI_URL=http://localhost:8080
# Optional bearer token; must match the API key TEI was started with (--api-key). Empty = no auth.
TEI_API_KEY=
# Inference timeout. On timeout or any error the comment stays unchecked; it is never approved.
TEI_TIMEOUT_MS=30000

# --- Classifier container (Compose only, `--profile classifier`) ---
# CLASSIFIER_COMPOSE_URL=http://classifier:8080
# CLASSIFIER_IMAGE_TAG=cpu-1.8
# Model folder of a training run (`<run>/model`), relative to infrastructure/docker/ (or absolute).
# CLASSIFIER_MODEL_DIR=../../apps/ai/training/outputs/chinese-roberta-v1/model
