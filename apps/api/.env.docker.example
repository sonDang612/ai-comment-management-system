# API settings inside Docker, for one environment.
# Copy to apps/api/.env.<env> (development | staging | production): `npm run env:init -- <env>`.
# Loaded by Compose as `env_file` for the `api` and `migrate` containers.
# APP_ENV, NODE_ENV, PORT and TZ are set by Compose. Hostnames are Compose service names.

APP_VERSION=0.1.0
# Comma-separated browser origins allowed to call the API (the web URL users open).
CORS_ORIGINS=http://localhost:3000

# --- Logging ---
# verbose | debug | log | warn | error | fatal
LOG_LEVEL=log
# text | json (json for log shipping in staging/production)
LOG_FORMAT=text

# --- PostgreSQL ---
# Also read by Compose (--env-file) to create the `postgres` container's user and database.
POSTGRES_USER=acms
POSTGRES_PASSWORD=acms
POSTGRES_DB=acms
# Prisma. Credentials must match POSTGRES_* above. `?schema=app`: tables live in the `app` schema.
DATABASE_URL=postgresql://acms:acms@postgres:5432/acms?schema=app

# --- Redis (BullMQ queues + cache) ---
REDIS_URL=redis://redis:6379/0

# --- AI server (apps/ai, internal HTTP) ---
AI_SERVICE_URL=http://ai-server:8000
# Shared secret; must match INTERNAL_API_TOKEN in apps/ai/.env.<env>. Use a long random value outside development.
AI_SERVICE_TOKEN=local-dev-internal-token
AI_SERVICE_TIMEOUT_MS=10000
